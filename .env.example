# NyaySetu local/staging environment template.
# Copy to .env for Flask CLI development only. Never commit real values.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ENV=development
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
MAINTENANCE_MODE=false
MAINTENANCE_ADMIN_BYPASS=

# ---------------------------------------------------------------------------
# Public support, policy, and internal notification destinations
# ---------------------------------------------------------------------------
SUPPORT_PHONE=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
PRIVACY_POLICY_URL=
TERMS_OF_SERVICE_URL=
REFUND_POLICY_URL=
CANCELLATION_POLICY_URL=
AI_CONSENT_VERSION=ai-privacy-2026-07
BOOKING_TERMS_VERSION=booking-terms-2026-07
LEGAL_CONTENT_VERSION=legal-content-2026-08-r5
LEGAL_CONTENT_REVIEWED_VERSION=
LEGAL_CONTENT_REVIEWED_ON=
BOOKING_NOTIFICATION_EMAILS=
SUPPORT_NOTIFICATION_EMAILS=
PAYMENT_RECONCILIATION_EMAILS=
SUPPORT_SLA_HOURS=24

# ---------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=v24.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Populate only during a planned rotation grace period, then clear it.
WHATSAPP_APP_SECRET_PREVIOUS=

# Signature checks stay enabled by default. This may be true only on a local
# machine when replaying unsigned fixtures; production ignores this opt-out.
ALLOW_INSECURE_WEBHOOKS=false
WHATSAPP_TIMEOUT_SECONDS=12
WHATSAPP_CONNECT_TIMEOUT_SECONDS=5
WHATSAPP_HTTP_MAX_RETRIES=1

# Consultation reminders are OFF while these values are empty. Populate only
# exact templates already approved by Meta as transactional/utility messages.
# Every enabled template must contain exactly two positional body variables:
# {{1}} appointment date and {{2}} appointment time. Configure name and
# language code as a pair; there is no automatic cross-language fallback.
WHATSAPP_REMINDER_24H_TEMPLATE_EN=
WHATSAPP_REMINDER_24H_LANGUAGE_EN=
WHATSAPP_REMINDER_24H_TEMPLATE_HI=
WHATSAPP_REMINDER_24H_LANGUAGE_HI=
WHATSAPP_REMINDER_24H_TEMPLATE_MR=
WHATSAPP_REMINDER_24H_LANGUAGE_MR=
WHATSAPP_REMINDER_2H_TEMPLATE_EN=
WHATSAPP_REMINDER_2H_LANGUAGE_EN=
WHATSAPP_REMINDER_2H_TEMPLATE_HI=
WHATSAPP_REMINDER_2H_LANGUAGE_HI=
WHATSAPP_REMINDER_2H_TEMPLATE_MR=
WHATSAPP_REMINDER_2H_LANGUAGE_MR=
# Run `python -m jobs.consultation_reminders` more frequently than this
# catch-up window (for example, every 15 minutes with the 30-minute default),
# then drain the durable outbox. Stale reminder jobs are completed without a
# user-visible send.
CONSULTATION_REMINDER_CATCHUP_MINUTES=30
CONSULTATION_REMINDER_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Webhook and event retention targets
# ---------------------------------------------------------------------------
WEBHOOK_MAX_PAYLOAD_BYTES=1048576
# Zero accepts delayed signed events; durable event IDs provide replay
# protection. A non-zero age limit should be enabled only with a reconciliation
# process that independently confirms every captured payment.
WEBHOOK_REPLAY_WINDOW_SECONDS=0
WEBHOOK_EVENT_TTL_DAYS=30
PROCESSED_MESSAGE_TTL_DAYS=30
INBOUND_MESSAGE_LEASE_SECONDS=120
INBOUND_USER_LOCK_TIMEOUT_SECONDS=25
USER_MESSAGE_LIMIT=10
USER_MESSAGE_WINDOW_SECONDS=60
AI_CALL_COOLDOWN_SECONDS=2
GLOBAL_REQUEST_LIMIT=600
GLOBAL_REQUEST_WINDOW_SECONDS=60

# ---------------------------------------------------------------------------
# Razorpay
# ---------------------------------------------------------------------------
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Populate only during a planned rotation grace period, then clear it.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
RAZORPAY_API_TIMEOUT_SECONDS=12
PAYMENT_RECONCILIATION_LOOKBACK_DAYS=14
PAYMENT_LINK_TTL_MINUTES=16
AUTO_SEND_RECEIPTS=false

# ---------------------------------------------------------------------------
# Booking policy and capacity
# ---------------------------------------------------------------------------
BOOKING_PRICE=499
BOOKING_CUTOFF_HOURS=2
BOOKING_MAX_AHEAD_DAYS=30
BOOKING_MAX_PER_DAY=8
BOOKING_MAX_PER_SLOT=1
# Python weekday numbers: Monday=0 through Sunday=6.
BOOKING_WORKING_WEEKDAYS=0,1,2,3,4,5
BOOKING_DATE_CHOICES=7

# ---------------------------------------------------------------------------
# Durable outbox
# ---------------------------------------------------------------------------
OUTBOX_MAX_ATTEMPTS=12
OUTBOX_RETRY_BASE_SECONDS=60
OUTBOX_RETRY_MAX_SECONDS=3600
OUTBOX_RUNNING_LEASE_SECONDS=900
OUTBOX_COMPLETED_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Amazon SES email (HTTPS API)
# ---------------------------------------------------------------------------
SES_REGION=ap-south-1
SES_FROM_EMAIL=
# Required in staging/production so delivery, bounce, complaint, reject, and
# delay events can be monitored.
SES_CONFIGURATION_SET=
SES_CONNECT_TIMEOUT_SECONDS=5
SES_READ_TIMEOUT_SECONDS=15
# Create a least-privilege IAM principal limited to ses:SendEmail for the
# verified NyaySetu identity. Store real values only in the deployment secret
# manager. AWS_SESSION_TOKEN remains empty for a normal IAM access key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# AI routing
# local is safest for development. In staging/production, choose auto, openai,
# claude, or local only after privacy/legal review and explicit user consent.
# ---------------------------------------------------------------------------
AI_PROVIDER=local
AI_PROVIDER_ORDER=openai,claude,local
AI_SAFETY_IDENTIFIER_SECRET=
AI_RESPONSE_CACHE_TTL_SECONDS=20

OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=12
OPENAI_CONNECT_TIMEOUT_SECONDS=5
OPENAI_HTTP_MAX_RETRIES=1
OPENAI_MAX_TOKENS=240
OPENAI_BREAKER_MINUTES=30

ANTHROPIC_API_KEY=
# Required when AI_PROVIDER includes Claude; choose a currently supported model
# only after the documented evaluation/approval.
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_SECONDS=15
ANTHROPIC_MAX_TOKENS=400

# Optional local Ollama endpoint.
LOCAL_AI_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------------------------------------------------------------------------
# Admin API
# ---------------------------------------------------------------------------
ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Database
# SQLite is for local development/test only. Staging and production must
# provide isolated internally reachable managed PostgreSQL URLs.
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./nyaysetu.db
# Staging and production must keep this false and run Alembic before startup.
AUTO_CREATE_SCHEMA=true
DB_POOL_PRE_PING=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
SQLITE_BUSY_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Privacy-minimised analytics
# These are retention targets; schedule a reviewed purge/anonymisation process
# before claiming that retention is automatically enforced.
# ---------------------------------------------------------------------------
ANALYTICS_EVENT_TTL_DAYS=90
ANALYTICS_MAX_PROPERTY_BYTES=8192
